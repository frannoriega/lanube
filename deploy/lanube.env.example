# Copiar a <APP_DIR>/lanube.env (por defecto /data/docker) (root, chmod 600). NUNCA al repo con valores reales.
# Valores sin comillas y sin espacios alrededor del "=": lo leen compose y systemd.

# --- Base de datos (la contraseña va también en postgres.env; hex, para no escapar la URL) ---
DATABASE_URL=postgresql://lanube:CAMBIAR@postgres:5432/lanube?schema=public

# --- Sitio ---
NODE_ENV=production
NEXTAUTH_URL=https://TU.DOMINIO
NEXTAUTH_SECRET=CAMBIAR            # openssl rand -base64 32
AUTH_TRUST_HOST=true               # detrás de Caddy/Cloudflare
CRON_SECRET=CAMBIAR                # openssl rand -hex 32; lo usan los timers del host
TURNSTILE_SECRET_KEY=CAMBIAR
# NEXT_PUBLIC_TURNSTILE_SITEKEY se pasa como variable del repo en GitHub (se incrusta en el build).

# --- Identidad pública: FIJARLA, no derivarla de headers ---
# Sin esto, las passkeys (rpID) y el emisor OAuth del conector MCP salen del header Host/X-Forwarded-Host
# de cada pedido. Mismo dominio que NEXTAUTH_URL.
WEBAUTHN_RP_ID=TU.DOMINIO
WEBAUTHN_ORIGIN=https://TU.DOMINIO
OAUTH_ISSUER=https://TU.DOMINIO

# --- Correo ---
SMTP_SERVER_HOST=smtp.ejemplo.com
SMTP_SERVER_PORT=587
SMTP_SERVER_USERNAME=CAMBIAR
SMTP_SERVER_PASSWORD=CAMBIAR
SMTP_SERVER_SECURE=false

# --- Archivos subidos: disco local (volumen persistente) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=/data/uploads
STORAGE_ENV_ROOT=prod

# --- Detrás de Cloudflare ---
# SOLO es seguro porque el firewall del host y Caddy (authenticated origin pulls) aceptan
# únicamente tráfico de Cloudflare. Si algún día se abre el origen, ponelo en false.
TRUST_CF_CONNECTING_IP=true
# El portero de mantenimiento se consulta a sí mismo: que no dependa del header Host.
MAINTENANCE_PROBE_ORIGIN=http://127.0.0.1:3000
