# Database
DATABASE_URL="postgresql://username:password@localhost:5432/la_nube_coworking?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Vercel Cron (GET /api/cron/maintain-reservations). Vercel injects Authorization: Bearer when set.
CRON_SECRET=""

# SMTP Server
# For local development, run Mailpit via Docker: docker compose -f docker/docker-compose.yml up -d
# Then visit http://localhost:8025 to inspect sent emails.
SMTP_SERVER_HOST="localhost"
SMTP_SERVER_PORT=1025
SMTP_SERVER_USERNAME=""
SMTP_SERVER_PASSWORD=""
SMTP_SERVER_SECURE=false

# File storage (event images). Provider selection:
#   STORAGE_PROVIDER="vercel-blob" | "local"  (optional; defaults to vercel-blob when
#   BLOB_READ_WRITE_TOKEN is set, otherwise "local" — writes to public/uploads for dev).
STORAGE_PROVIDER=""
# Vercel Blob token (required in production / when STORAGE_PROVIDER=vercel-blob).
BLOB_READ_WRITE_TOKEN=""
# Optional extra image host to allow in next/image (future custom/S3 provider).
STORAGE_PUBLIC_HOST=""
