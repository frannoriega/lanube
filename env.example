# Database
DATABASE_URL="postgresql://username:password@localhost:5432/la_nube_coworking?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Vercel Cron (GET /api/cron/maintain-reservations). Vercel injects Authorization: Bearer when set.
CRON_SECRET=""

# Cloudflare Turnstile (captcha on register / password-reset).
# The values below are Cloudflare's official test keys, which ALWAYS pass and
# accept any hostname — safe for local dev. Use real keys in production, and make
# sure the widget's hostname allowlist includes your preview domains (*.vercel.app).
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITEKEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# SMTP Server
# For local development, run Mailpit via Docker: docker compose -f docker/docker-compose.yml up -d
# Then visit http://localhost:8025 to inspect sent emails.
SMTP_SERVER_HOST="localhost"
SMTP_SERVER_PORT=1025
SMTP_SERVER_USERNAME=""
SMTP_SERVER_PASSWORD=""
SMTP_SERVER_SECURE=false

# File storage (event images). Provider selection:
#   STORAGE_PROVIDER="vercel-blob" | "local"  (optional; defaults to vercel-blob when
#   BLOB_READ_WRITE_TOKEN is set, otherwise "local" — writes to public/uploads for dev).
STORAGE_PROVIDER=""
# Vercel Blob token (required in production / when STORAGE_PROVIDER=vercel-blob).
BLOB_READ_WRITE_TOKEN=""
# Optional extra image host to allow in next/image (future custom/S3 provider).
STORAGE_PUBLIC_HOST=""

# Rate-limit client-IP resolution (src/lib/request-ip.ts).
# Only headers the hosting platform sets are trusted. On Vercel that's x-real-ip /
# x-forwarded-for, both rewritten at the edge. Set this to "true" ONLY if the deployment is
# genuinely behind Cloudflare — otherwise cf-connecting-ip is attacker-supplied and trusting
# it makes every rate limit (register, reset, form submit, upload) bypassable by rotating it.
TRUST_CF_CONNECTING_IP="false"

# Modo mantenimiento (milestone 22/25) — OPCIONAL, para un VPS. El middleware consulta las
# ventanas con un fetch a la propia app; por defecto al origen del pedido (header Host). Detrás
# de un proxy propio, fijarlo al origen interno para que un Host arbitrario no lo redirija:
# MAINTENANCE_PROBE_ORIGIN="http://127.0.0.1:3000"

# Passkeys (WebAuthn, milestone 17) — OPCIONAL. Por defecto el sitio (rpID/origen) se toma
# del host al que entró el navegador, así funciona en local, en previews y en producción sin
# configurar nada. Fijalos solo si un proxy reescribe el host. Una passkey queda atada a su
# rpID: las creadas en producción no sirven en una preview.
# WEBAUTHN_RP_ID="lanube.example"
# WEBAUTHN_ORIGIN="https://lanube.example"

# Conector MCP (milestone 20): el issuer OAuth y la URL de /api/mcp salen del host de cada
# request (X-Forwarded-Host / Host), igual que las passkeys. Fijalo solo si un proxy
# reescribe el host (p. ej. detrás de un reverse proxy mal configurado en un VPS).
# OAUTH_ISSUER="https://lanube.example"
