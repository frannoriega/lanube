// NOTE: the `UserRole` enum was removed in migration 20260924000000_dynamic_roles
// (milestone 9). Roles are now rows in the `roles` table, created and scoped by a
// superadmin at /admin/roles; USER/ADMIN/SUPERADMIN/COMUNICADOR are seeded there as
// ordinary (system-protected) rows. See prisma/models/roles.prisma.

enum IncidentStatus {
  OPEN
  RESOLVED
  CLOSED

  @@map("incident_statuses")
}

enum OrderStatus {
  PENDING
  DONE
  CANCELLED

  @@map("order_statuses")
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("proposal_statuses")
}

enum ReservableType {
  USER
  EVENT
  ORGANIZATION
  TEAM

  @@map("reservable_types")
}

// Lifecycle of an event. ENDED is NOT stored — it's derived when the last occurrence has
// passed (see eventDisplayStatus); only these three values are persisted.
enum EventStatus {
  DRAFT
  PUBLISHED
  PAUSED

  @@map("event_statuses")
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("reservation_statuses")
}

// Lifecycle of an event registration. A participant "holds a spot" (counts toward the event's
// capacity/cupo) while PENDING or APPROVED; REJECTED (by an admin) and CANCELLED (by the
// participant) free the spot. Auto-approve events never produce PENDING rows.
enum ParticipantStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("participant_statuses")
}

// Entrance effect a landing theme plays on first visit while its window is active.
// Kept as a small, developer-owned set (not free-form) so a superadmin can only pick
// among presets built and vetted in code — see docs/milestones/milestones-3-seasonal-landing-themes.md.
enum LandingThemeEffect {
  NONE
  EMOJI_SHOWER

  @@map("landing_theme_effects")
}

// How a theme's heroKeywords combine with HeroSection's default rotating keyword list.
enum LandingThemeKeywordMode {
  APPEND
  REPLACE

  @@map("landing_theme_keyword_modes")
}

// Approval state machine for a Noticias post — see prisma/models/news.prisma.
enum NewsPostStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  PAUSED

  @@map("news_post_statuses")
}

// A request pending decision against an already-PUBLISHED Noticia — see
// prisma/models/news.prisma. Null (no row) means nothing is pending.
enum NewsPendingAction {
  EDIT
  PAUSE
  DELETE

  @@map("news_pending_actions")
}

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  INTEGER
  FLOAT
  MONEY
  SINGLE_SELECT
  MULTI_SELECT
  DATE
  TIME
  PHONE
  DNI
  FILE
  BOOLEAN

  @@map("form_field_types")
}
