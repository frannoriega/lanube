model RateLimit {
   id           String  @id @default(cuid())
   key          String
   endpoint     String
   attempts     Int     @default(1)
   windowStart  BigInt  @default(dbgenerated("((EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint)"))
   blockedUntil BigInt?
   createdAt    BigInt  @default(dbgenerated("((EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint)"))
   updatedAt    BigInt  @default(dbgenerated("((EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint)"))

   @@unique([key, endpoint])
   @@index([key, endpoint, windowStart])
   @@map("rate_limits")
}
