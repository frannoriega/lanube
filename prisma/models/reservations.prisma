/// Canal por el que se pidió una reserva (milestone 20).
enum ReservationOrigin {
  WEB
  ASSISTANT
}

model Reservation {
  id             String                 @id @default(cuid())
  reservableType ReservableType         @map("reservable_type")
  reservableId   String                 @map("reservable_id")
  spaceId        String?                @map("space_id")
  // Code of a ReservationType row (FK on `code`, not `id`).
  eventType      String                 @map("event_type")
  reason         String
  deniedReason   String?                @map("denied_reason")
  status         ReservationStatus      @default(PENDING)
  startTime      BigInt                 @map("start_time")
  endTime        BigInt                 @map("end_time")
  isRecurring    Boolean                @default(false) @map("is_recurring")
  rrule          String?
  recurrenceEnd  BigInt?                @map("recurrence_end")
  /// Por dónde se pidió (milestone 20): la web o un asistente conectado por MCP. Solo
  /// informativo — el admin lo ve como un chip al aprobar; ninguna regla lo mira.
  origin           ReservationOrigin    @default(WEB)
  /// Nombre declarado del asistente cuando `origin = ASSISTANT` ("Claude").
  originClientName String?              @map("origin_client_name")
  createdAt      BigInt                 @default(dbgenerated("((EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint)")) @map("created_at")
  updatedAt      BigInt                 @default(dbgenerated("((EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint)")) @map("updated_at")
  checkIns       CheckIn[]
  exceptions     ReservationException[]
  ledger         ReservationLedger[]
  registeredUser RegisteredUser         @relation(fields: [reservableId], references: [id], onDelete: Cascade)
  space          Space?                 @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  type           ReservationType        @relation(fields: [eventType], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@index([reservableType, reservableId])
  @@index([spaceId])
  @@index([status])
  @@index([startTime, endTime])
  @@index([eventType])
  @@map("reservations")
}

model ReservationException {
  id            String      @id @default(cuid())
  reservationId String      @map("reservation_id")
  exceptionDate BigInt      @map("exception_date")
  isCancelled   Boolean     @default(false) @map("is_cancelled")
  newStartTime  BigInt?     @map("new_start_time")
  newEndTime    BigInt?     @map("new_end_time")
  reason        String?
  createdAt     BigInt      @default(dbgenerated("((EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint)")) @map("created_at")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([exceptionDate])
  @@map("reservation_exceptions")
}

/// Expansión materializada de cada reserva en buckets de 15 minutos. Es lo **único** que se
/// consulta para capacidad y disponibilidad — la tabla `reservations` nunca se suma —, así que
/// nunca debe sobrevivir a la reserva que describe ni discrepar con ella. Dos garantías a
/// nivel de base lo aseguran (migración `20260924100000_ledger_integrity`): la relación
/// `reservation` cascadea al borrar, y un trigger `AFTER UPDATE OF status` sobre
/// `reservations` propaga acá cada cambio de estado. No "optimizar" ninguna de las dos: antes
/// de que existieran, cancelar una reserva dejaba el lugar bloqueado para siempre
/// (milestone-12 D1/D2).
model ReservationLedger {
  id                  Int               @id @default(autoincrement())
  reservationId       String            @map("reservation_id")
  reservation         Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  occurrenceStartTime BigInt            @map("occurrence_start_time")
  occurrenceEndTime   BigInt            @map("occurrence_end_time")
  reservableType      ReservableType    @map("reservable_type")
  reservableId        String            @map("reservable_id")
  spaceId             String            @map("space_id")
  // Snapshot of the reservation's type code (derived data — no FK; rebuilt from reservations).
  eventType           String            @map("event_type")
  reason              String?
  actorSize           Int               @map("actor_size")
  status              ReservationStatus
  createdAt           BigInt            @default(dbgenerated("((EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint)")) @map("created_at")

  @@index([reservationId])
  @@index([spaceId, status, occurrenceStartTime])
  @@index([occurrenceStartTime, occurrenceEndTime])
  @@index([reservableId, reservableType, status], map: "reservation_ledger_reservable_status_idx")
  @@map("reservation_ledger")
}

model CheckIn {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  reservationId  String?        @map("reservation_id")
  checkInTime    BigInt         @default(dbgenerated("((EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint)")) @map("check_in_time")
  checkOutTime   BigInt?        @map("check_out_time")
  createdAt      BigInt         @default(dbgenerated("((EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint)")) @map("created_at")
  updatedAt      BigInt         @default(dbgenerated("((EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint)")) @map("updated_at")
  reservation    Reservation?   @relation(fields: [reservationId], references: [id])
  registeredUser RegisteredUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  incidentUsers  IncidentUser[]

  @@index([userId])
  @@index([checkInTime])
  @@map("check_ins")
}
