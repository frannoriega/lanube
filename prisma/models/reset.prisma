model PasswordResetToken {
  id        String         @id @default(cuid())
  token     String         @unique
  userId    String
  user      RegisteredUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt BigInt
  usedAt    BigInt?
  createdAt BigInt         @default(dbgenerated("((EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint)"))

  @@index([userId])
  @@map("password_reset_tokens")
}
