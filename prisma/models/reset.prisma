model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique 
  userId    String
  user      RegisteredUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime? // null = no usado todavía
  createdAt DateTime @default(now())

  @@index([userId])
}