model Resource {
  id           String  @id @default(cuid())
  name         String
  serialNumber String? @unique @map("serial_number")
  metadata     Json?
  createdAt    BigInt  @default(dbgenerated("((EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint)")) @map("created_at")
  updatedAt    BigInt  @default(dbgenerated("((EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint)")) @map("updated_at")

  @@map("resources")
}

model Space {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String
  // Rich, long-form description shown on the public "Espacios" page (markdown). The short
  // `description` above stays the landing/booking overview blurb.
  longDescription String?    @map("long_description")
  // Ordered FAQ entries shown on the public "Espacios" page. JSON array of
  // `{ question: string; answer: string }` (answer is markdown). See lib/types/spaces.ts.
  faqs         Json?
  imageUrl     String?       @map("image_url")
  iconName     String?       @map("icon_name")
  capacity     Int           @default(1)
  isExclusive  Boolean       @default(false) @map("is_exclusive")
  isReservable Boolean       @default(false) @map("is_reservable")
  isFeatured   Boolean       @default(false) @map("is_featured")
  displayOrder Int           @default(0) @map("display_order")
  metadata     Json?
  createdAt    BigInt        @default(dbgenerated("((EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint)")) @map("created_at")
  updatedAt    BigInt        @default(dbgenerated("((EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint)")) @map("updated_at")
  reservations Reservation[]
  events       Event[]

  @@map("spaces")
}
