{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] || [ \"$VERCEL_GIT_COMMIT_REF\" = \"preview\" ]",
  "crons": [
    {
      "path": "/api/cron/maintain-reservations",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/report-snapshot",
      "schedule": "0 6 1 * *"
    }
  ]
}
