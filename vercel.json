{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "preview": true,
      "**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/maintain-reservations",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/report-snapshot",
      "schedule": "0 6 1 * *"
    }
  ]
}
