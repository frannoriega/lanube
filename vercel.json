{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"preview\" ]",
  "crons": [
    {
      "path": "/api/cron/maintain-reservations",
      "schedule": "0 5 * * *"
    }
  ]
}
